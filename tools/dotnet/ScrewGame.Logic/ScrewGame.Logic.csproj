<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Unity assemblies outside Unity with Unity's C# language level. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/ScrewGame/Contracts/**/*.cs" />
    <Compile Include="../../../Assets/ScrewGame/Core/**/*.cs" />
    <Compile Include="../../../Assets/ScrewGame/Validation/**/*.cs" />
    <Compile Include="../../../Assets/ScrewGame/Session/**/*.cs" />
    <Compile Include="../../../Assets/ScrewGame/Persistence/**/*.cs" />
    <Compile Include="../../../Assets/ScrewGame/Progression/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
